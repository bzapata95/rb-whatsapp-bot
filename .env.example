# Copia este archivo a .env y rellena los valores

# ID del grupo de donde se leen los productos (ej: 123456789-987654321@g.us)
GRUPO_ORIGEN_ID=

# ID del grupo al que se envían los productos con precio en Soles
GRUPO_DESTINO_ID=

# Opcional: grupo de rastreo (recibe mensaje ORIGINAL con cabecera: fecha, quién envía, display, número, grupo, etc.)
# GRUPO_RASTREO_ID=123456789-1234567890@g.us

# Opcional: tipo de cambio (1 USD = X soles)
# TIPO_CAMBIO_SOLES=3.75

# Opcional: fórmula de precio USA → Soles (por defecto en config.js)
# PORCENTAJE_IMPUESTO=6.5
# PORCENTAJE_SHOPPER=20
# PORCENTAJE_GANANCIA=15
# ENVIO_USD=10

# Opcional: mensaje de bienvenida cuando agregan usuarios al grupo destino (usa \n para saltos de línea)
# MENSAJE_BIENVENIDA=¡Bienvenido(s)!\n\nPara comprar:\n1. Revisa productos\n2. Escribe al admin...

# Opcional: ruta a Chrome/Chromium (solo si no se detecta; en Linux suele ser /usr/bin/chromium o /usr/bin/chromium-browser)
# CHROME_PATH=/usr/bin/chromium-browser
